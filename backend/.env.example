# Copy this file to ".env" and fill in real values.

# Server
PORT=4000

# PostgreSQL connection string.
# Local example:  postgresql://postgres:postgres@localhost:5432/prosales
# Neon (free cloud) example: postgresql://user:pass@ep-xxx.aws.neon.tech/prosales?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prosales

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Where uploaded visit photos are stored (relative to backend/)
UPLOAD_DIR=uploads

# Allowed dashboard origin(s) for CORS. '*' = any (fine for dev).
# In production set to your dashboard URL, e.g. https://prosales-dashboard.onrender.com
CORS_ORIGIN=*
